    </Service>
    <Service id="DP-SVC-grace-legacy-contracts">
      <Name>grace-legacy-contracts</Name>
      <Description>Infers draft MC, FC, and BA contracts over legacy code so semantic navigation and controlled modification can begin.</Description>
      <Links>
