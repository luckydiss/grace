  <Flows>
    <Flow id="Flow-GRACE-MainWorkflow">
      <Description>
        Intake -> blueprint review -> handoff proposal -> approval interrupt -> CWO issuance
        -> bounded architect/coordinator/coder execution -> verification -> traceability gate
        -> release or remediation branch.
      </Description>
      <Links>
        <Link ref="RequirementsAnalysis.xml#UC-GRACE-STATE-MACHINE" />
        <Link ref="RequirementsAnalysis.xml#UC-GRACE-HUMAN-APPROVAL" />
        <Link ref="RequirementsAnalysis.xml#UC-GRACE-BOUNDED-EXECUTION" />
      </Links>
    </Flow>

    <Flow id="Flow-GRACE-FailureBranch">
      <Description>
        Verification fail -> failure capture -> failure memory append -> forced context injection
        -> loop guard -> remediation allowed or blocked escalation.
      </Description>
      <Links>
        <Link ref="RequirementsAnalysis.xml#UC-GRACE-FAILURE-RECOVERY" />
      </Links>
    </Flow>
    <Flow id="Flow-GRACE-LegacyOnboarding">
      <Description>
        Legacy overlay bootstrap -> repository scan -> draft contract inference -> trace seed
        -> first safe slice proposal -> approval boundary -> bounded safe edit path.
      </Description>
      <Links>
        <Link ref="RequirementsAnalysis.xml#UC-GRACE-LEGACY-ONBOARDING" />
        <Link ref="RequirementsAnalysis.xml#UC-GRACE-LEGACY-SCAN" />
        <Link ref="RequirementsAnalysis.xml#UC-GRACE-LEGACY-CONTRACT-INFERENCE" />
        <Link ref="RequirementsAnalysis.xml#UC-GRACE-LEGACY-SLICE-PROPOSAL" />
      </Links>
    </Flow>
  </Flows>

