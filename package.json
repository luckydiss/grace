{
  "name": "grace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:tools": "tsc -p tsconfig.tools.json",
    "grace:init": "node out/tools/grace-init.js",
    "validate:framework": "node out/tools/grace-validate.js --mode framework",
    "validate:product": "node out/tools/grace-validate.js --mode product --root .",
    "validate": "npm run build:tools && npm run validate:framework && npm run validate:product",
    "verify": "npm run build && npm run build:tools && node out/tools/grace-verify.js",
    "execution-proof": "node out/tools/grace-execution-proof.js",
    "execution-schema": "node out/tools/grace-execution-schema.js",
    "delivery-trace": "node out/tools/grace-delivery-trace.js",
    "schema-validate": "node out/tools/grace-schema-validate.js",
    "workflow:start": "node dist/cli/run-workflow.js start --repo-root . --product-root . --product-id grace",
    "workflow:resume": "node dist/cli/run-workflow.js resume --repo-root . --product-root . --product-id grace --approval-decision approve",
    "mcp:build": "npm --prefix mcp run build",
    "mcp:test": "npm --prefix mcp run test",
    "mcp:start": "npm --prefix mcp run start",
    "mcp:start:http": "npm --prefix mcp run start:http",
    "test:core": "node scripts/run-tests.mjs dist --exclude-dir graph",
    "test:graph": "node scripts/run-tests.mjs dist/graph",
    "test:tools": "node scripts/run-tests.mjs out",
    "test": "npm run build && npm run build:tools && npm run test:core && npm run test:graph && npm run test:tools",
    "coverage": "npm run build && npm run build:tools && node scripts/run-tests.mjs --coverage dist out --exclude-dir graph"
  },
  "dependencies": {
    "@langchain/core": "^0.3.80",
    "@langchain/langgraph": "^0.4.9",
    "@langchain/langgraph-checkpoint": "^0.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "typescript": "~5.9.0"
  }
}
